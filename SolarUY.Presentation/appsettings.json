{
  "ConnectionStrings": {
    "SolarUY": "Server=127.0.0.1;Port=3307;Database=solaruy;User=solaruy;Password=solaruy_dev_password;"
  },
  "MariaDB": {
    "ServerVersion": "11.8.0"
  },
  "RecoleccionLecturas": {
    "Habilitada": true,
    "IntervaloSegundos": 60
  },
  "Monitoreo": {
    "IntervalosVigencia": 2,
    "MaximoPuntosGrafico": 120,
    "ReevaluacionSegundos": 5
  },
  "DistribucionMonitoreo": {
    "InstanciaId": "solaruy-local",
    "IntervaloSegundos": 1,
    "TamanoLote": 100
  },
  "InversorTcp": {
    "Host": "127.0.0.1",
    "Port": 5055,
    "TimeoutSeconds": 3
  },
  "Authentication": {
    "OpenIdConnect": {
      "Authority": "http://localhost:8080/realms/solaruy",
      "ClientId": "solaruy-web"
    }
  },
  "Keycloak": {
    "Directory": {
      "BaseUrl": "http://localhost:8080",
      "Realm": "solaruy",
      "ClientId": "solaruy-tecnico-directory"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
