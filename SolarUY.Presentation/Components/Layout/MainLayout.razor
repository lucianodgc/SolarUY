@inherits LayoutComponentBase
<RadzenDialog />
<RadzenNotification />
<div class="page">
    <aside class="sidebar"><NavMenu /></aside>
    <main>
        <header class="top-row">
            <span class="platform-name">Plataforma de gestión solar</span>
            <AuthorizeView>
                <Authorized Context="sesion">
                    <div class="session-actions">
                        <a class="session-user" href="/mi-cuenta"><RadzenIcon Icon="account_circle" /> @(sesion.User.Identity?.Name ?? "Mi cuenta")</a>
                        <form method="post" action="/Account/Logout">
                            <AntiforgeryToken />
                            <button type="submit" class="logout-button">Cerrar sesión</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="content">@Body</article>
        <footer class="site-footer">SolarUY</footer>
    </main>
</div>
<div id="blazor-error-ui" role="alert">
    Se interrumpió la conexión con la aplicación.
    <a href="" class="reload">Recargar página</a>
    <a class="dismiss" aria-label="Cerrar aviso">×</a>
</div>
