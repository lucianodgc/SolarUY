@inherits LayoutComponentBase

<RadzenNotification />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized Context="sesion">
                    <details>
                        <summary>@(sesion.User.Identity?.Name ?? "Usuario")</summary>
                        <ul>
                            @foreach (var claim in sesion.User.Claims)
                            {
                                <li><strong>@claim.Type:</strong> @claim.Value</li>
                            }
                        </ul>
                        <form method="post" action="/Account/Logout">
                            <AntiforgeryToken />
                            <button type="submit">Cerrar sesión</button>
                        </form>
                    </details>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
