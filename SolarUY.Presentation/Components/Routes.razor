<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <PageHeader Title="Acceso denegado" Section="Permisos" />
                <section class="surface"><p role="alert">No tienes permisos para acceder a esta página.</p><a href="/">Volver al inicio</a></section>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
