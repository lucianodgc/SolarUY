@page "/simulador"
@implements IAsyncDisposable
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@inject SolarUY.Application.Inversores.IInversorService Inversor
@inject ILogger<SimuladorInversor> Logger
@using SolarUY.Application.Inversores
@using SolarUY.Application.Abstractions

<PageTitle>Simulador de inversor | SolarUY</PageTitle>
<PageHeader Title="Simulador de inversor" Section="Operación" Description="Consultá el estado de los paneles y la potencia generada en la simulación." />
<p class="note">Los nodos y paneles se leen del inventario de la base de datos. La potencia es simulada y aleatoria; los controles afectan solo la simulación y no modifican los registros guardados. El volcado a red solo representa ese estado: no hay conexión eléctrica real.</p>
<div class="surface filter-toolbar">
    <RadzenLabel Text="Nodo" Component="NodoSimulado" />
    <RadzenDropDown TValue="string" Name="NodoSimulado" Data="_nodos" TextProperty="Nombre" ValueProperty="Id" @bind-Value="_nodoId" Disabled="_ocupado" Style="min-width:180px" />
    <RadzenButton Text="Consultar / Actualizar" Icon="refresh" Click="CargarAsync" Disabled="_ocupado" IsBusy="_ocupado" />
    <span class="text-muted small">Actualización automática cada 5 segundos.</span>
</div>
@if (_error is not null)
{
    <p class="alert alert-danger" role="alert">@_error</p>
}
@if (_estado is not null)
{
    <div class="metric-grid">
        <div class="metric-card"><span class="metric-label">Potencia del nodo</span><strong class="metric-value">@_estado.PotenciaGeneradaW.ToString("N2") <small>W</small></strong></div>
        <div class="metric-card"><span class="metric-label">Paneles del nodo</span><strong class="metric-value">@_estado.Paneles.Count</strong></div>
        <div class="metric-card"><span class="metric-label">Inversor</span><strong class="metric-value">@(_estado.InversorEncendido ? "Encendido" : "Apagado")</strong></div>
        <div class="metric-card"><span class="metric-label">Volcado a la red</span><strong class="metric-value">@(_estado.VolcadoRedActivo ? "Activo" : "Inactivo")</strong></div>
    </div>
    <section class="surface">
        <div class="page-heading">
            <div><h2>@_estado.NodoNombre</h2><span class="text-muted small">Parque: @_estado.ParqueNombre · Consulta: @_estado.FechaConsultaUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span></div>
            @if (_estado.PuedeOperar)
            {
                <div class="action-buttons">
                    <RadzenButton Text="@(_estado.InversorEncendido ? "Apagar inversor" : "Prender inversor")"
                                  ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Disabled="_ocupado"
                                  Click="@(() => CambiarInversorAsync(!_estado.InversorEncendido))" />
                    <RadzenButton Text="@(_estado.VolcadoRedActivo ? "Desactivar volcado a red" : "Activar volcado a red")"
                                  ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Secondary" Disabled="_ocupado"
                                  Click="@(() => CambiarVolcadoAsync(!_estado.VolcadoRedActivo))" />
                </div>
            }
        </div>
        @if (!_estado.PuedeOperar)
        {
            <p class="note">Tu perfil permite consultar la simulación. Los controles están disponibles para Administrador.</p>
        }
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th scope="col">Panel</th><th scope="col">Operación</th><th scope="col">Salud</th><th scope="col">Potencia (W)</th>@if (_estado.PuedeOperar) { <th scope="col">Acciones</th> }</tr></thead>
                <tbody>
                    @foreach (var panel in _estado.Paneles)
                    {
                        <tr>
                            <td><strong>@panel.NumeroSerie</strong><br /><span class="text-muted small">ID: @panel.PanelId</span></td>
                            <td><span class="state-badge @(panel.EstaActivo ? "" : "state-neutral")">@(panel.EstaActivo ? "Activo" : "Inactivo")</span></td>
                            <td><span class="state-badge @(panel.EstadoSalud == EstadoSaludPanel.Fallado ? "state-danger" : "")">@panel.EstadoSalud</span></td>
                            <td>@panel.PotenciaGeneradaW.ToString("N2")</td>
                            @if (_estado.PuedeOperar)
                            {
                                <td><RadzenButton Text="@(panel.EstaActivo ? "Desactivar" : "Activar")" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                  Disabled="_ocupado" Click="@(() => CambiarPanelAsync(panel))" /></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_estado.Paneles.Count == 0) { <p class="empty-state">Este nodo simulado no tiene paneles.</p> }
    </section>
}
else if (_ocupado)
{
    <p class="loading-state" role="status">Cargando simulación…</p>
}
else if (_error is null)
{
    <p class="empty-state">No hay nodos registrados para mostrar.</p>
}

@code {
    private static readonly TimeSpan IntervaloActualizacion = TimeSpan.FromSeconds(5);
    private IReadOnlyList<InventarioNodoInversorDto> _nodos = Array.Empty<InventarioNodoInversorDto>();
    private string? _nodoId;
    private EstadoInversorDto? _estado;
    private bool _ocupado;
    private string? _error;
    private readonly CancellationTokenSource _cancelacionActualizacion = new();
    private Task? _actualizacionAutomatica;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        _actualizacionAutomatica = ActualizarPeriodicamenteAsync(_cancelacionActualizacion.Token);
    }

    private Task CargarAsync() => EjecutarAsync(async () =>
    {
        _nodos = await Inversor.ListarNodosAsync();
        if (_nodoId is null || _nodos.All(nodo => nodo.Id != _nodoId))
            _nodoId = _nodos.FirstOrDefault()?.Id;
        _estado = null;
    });

    private Task CambiarPanelAsync(PanelInversorEstadoDto panel)
        => EjecutarAsync(() => Inversor.EstablecerPanelActivoAsync(panel.NodoId, panel.PanelId, !panel.EstaActivo));

    private Task CambiarVolcadoAsync(bool activo)
        => EjecutarAsync(() => Inversor.EstablecerVolcadoRedAsync(activo));

    private Task CambiarInversorAsync(bool encendido)
        => EjecutarAsync(() => Inversor.EstablecerInversorEncendidoAsync(encendido));

    private async Task ActualizarPeriodicamenteAsync(CancellationToken cancellationToken)
    {
        using var temporizador = new PeriodicTimer(IntervaloActualizacion);
        try
        {
            while (await temporizador.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (_ocupado || _nodoId is null) return;

                    _ocupado = true;
                    try
                    {
                        _estado = await Inversor.ConsultarAsync(_nodoId, cancellationToken);
                        _error = null;
                    }
                    catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                    {
                        return;
                    }
                    catch (Exception exception)
                    {
                        Logger.LogWarning(exception, "Falló la actualización automática del simulador de inversor");
                        _estado = null;
                        _error = "No se pudo actualizar la simulación. Se volverá a intentar automáticamente.";
                    }
                    finally
                    {
                        _ocupado = false;
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // La navegación fuera de la página detiene la actualización periódica.
        }
    }

    private async Task EjecutarAsync(Func<Task> accion)
    {
        if (_ocupado) return;
        _ocupado = true;
        _error = null;
        try
        {
            await accion();
            if (_nodoId is not null) _estado = await Inversor.ConsultarAsync(_nodoId);
        }
        catch (UnauthorizedAccessException exception) { _error = exception.Message; }
        catch (KeyNotFoundException exception) { _estado = null; _error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Error al operar el simulador de inversor");
            _estado = null;
            _error = "No se pudo consultar o actualizar la simulación. Volvé a intentarlo.";
        }
        finally { _ocupado = false; }
    }

    public async ValueTask DisposeAsync()
    {
        await _cancelacionActualizacion.CancelAsync();
        if (_actualizacionAutomatica is not null)
            await _actualizacionAutomatica;
        _cancelacionActualizacion.Dispose();
    }
}
