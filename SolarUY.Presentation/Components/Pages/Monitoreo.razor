@page "/monitoreo"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@using SolarUY.Application.Monitoreo
@using SolarUY.Application.RecoleccionLecturas
@using SolarUY.Domain.Monitoreo
@using SolarUY.Presentation.Monitoreo
@using SolarUY.Application.Inversores
@implements IAsyncDisposable
@inject IMonitoreoService Servicio
@inject SerieMonitoreoService Serie
@inject ConfiguracionRecoleccion Configuracion
@inject IJSRuntime Js
@inject Microsoft.Extensions.Options.IOptions<MonitoreoOptions> Opciones
@inject ILogger<Monitoreo> Logger
@inject NavigationManager Navegacion

<PageTitle>Monitoreo | SolarUY</PageTitle>
<PageHeader Title="Monitoreo en vivo" Section="Energía"
            Description="Potencia medida del parque, sus nodos y paneles." />
<section class="surface" aria-label="Monitoreo de generación">
    <div class="filter-bar">
        <label>Parque solar
            <RadzenDropDown Name="ParqueMonitoreo" data-testid="selector-parque" TValue="Guid" Data="_parques"
                            TextProperty="Nombre" ValueProperty="Id" @bind-Value="_parqueId" Change="CambiarParqueAsync"
                            Style="min-width:260px" />
        </label>
        <p role="status">Conexión: <span data-monitoreo-conexion>@_conexion</span></p>
    </div>
    <p class="note">Potencia en W · Fechas UTC · Los valores parciales excluyen paneles sin muestras compatibles.</p>
    @if (_error is not null)
    {
        <p role="alert" class="text-danger">@_error</p>
    }
    @if (_parques.Count == 0)
    {
        <p>No hay parques disponibles.</p>
    }
    @if (_parqueId != Guid.Empty && _ultimaTelemetriaUtc == default && _conexion is not "Sesión no autorizada" and not "Sin datos recientes")
    {
        <p class="loading-state" role="status">Recibiendo la primera muestra en vivo del parque…</p>
    }
    else if (_estado is { } estado)
    {
        <h2>@estado.Nombre</h2>
        <p class="metric-value">@Potencia(estado.Generacion.PotenciaW)</p>
        <p>@Cobertura(estado.Generacion) · Lecturas: @Fecha(estado.Generacion.FechaDesdeUtc) —
            @Fecha(estado.Generacion.FechaHastaUtc)</p>
            @foreach (var nodo in estado.Nodos)
            {
                <section class="surface" @key="nodo.Id">
                    <h3>@nodo.Nombre · @Potencia(nodo.Generacion.PotenciaW)</h3>
                    <p>@Cobertura(nodo.Generacion)</p>
                    <RadzenDataGrid Data="nodo.Paneles" TItem="PanelMonitoreoDto" AllowPaging="true" PageSize="20">
                        <Columns>
                            <RadzenDataGridColumn TItem="PanelMonitoreoDto" Property="NumeroSerie" Title="Panel / serie" />
                            <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Potencia"><Template
                                Context="panel">@Potencia(panel.Generacion.PotenciaW)</Template></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Disponibilidad"><Template
                                    Context="panel">@Disponibilidad(panel.Generacion.Disponibilidad)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Medición UTC"><Template
                                    Context="panel">@Fecha(panel.Generacion.FechaHoraUtc)</Template></RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                            @if (nodo.Paneles.Count == 0)
                            {
                                <p>Sin paneles.</p>
                            }
                        </section>
                    }
                    @if (estado.Nodos.Count == 0)
                    {
                        <p>Sin nodos.</p>
                    }
                }
            </section>
            <SaludMonitoreo ParqueId="_parqueId" @ref="_salud" />
            <p class="note">Para operar paneles o el volcado a red, abrí el <a href="/simulador">Simulador de inversor</a>.</p>
            <section class="surface" aria-label="Gráfico de potencia en vivo">
                <h2>Evolución de potencia del parque</h2>
                <p class="note">UTC · W · Hasta @Opciones.Value.MaximoPuntosGrafico puntos. Se inicia un tramo nuevo tras intervalos
                    sin muestras. Los puntos pueden representar cobertura parcial.</p>
                    @if (_puntos.Count > 0)
                    {
                        <RadzenChart Style="height:320px">
                            <RadzenLineSeries Data="_puntos" TItem="PuntoGeneracionDto" CategoryProperty="FechaHoraUtc"
                                              ValueProperty="PotenciaW" Title="Potencia medida (W)">
                                <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis FormatString="{0:HH:mm:ss}">
                                <RadzenAxisTitle Text="Fecha/hora UTC" />
                            </RadzenCategoryAxis>
                            <RadzenValueAxis>
                                <RadzenAxisTitle Text="Potencia (W)" />
                            </RadzenValueAxis>
                        </RadzenChart>
                        <details>
                            <summary>Fechas y cobertura de los puntos</summary>
                            @foreach (var punto in _puntos)
                            {
                                <p>@Fecha(punto.FechaHoraUtc) · @Potencia(punto.PotenciaW) · @(punto.Parcial ?
                                     "Parcial" : "Completo")</p>
                                }
                            </details>
                        }
    else
                        {

                            <p>Aún no hay puntos disponibles.</p>
                        }
                    </section>

@code {
    [SupplyParameterFromQuery(Name = "parque")]
    public Guid? ParqueSeleccionado { get; set; }
    private IReadOnlyList<ParqueMonitoreoDto> _parques = [];
    private Guid _parqueId;
    private EstadoMonitoreoDto? _estado;
    private IReadOnlyList<PuntoGeneracionDto> _puntos = [];
    private string _conexion = "Conectando";
    private string? _error;
    private IJSObjectReference? _modulo;
    private IJSObjectReference? _puente;
    private DotNetObjectReference<Monitoreo>? _referencia;
    private readonly CancellationTokenSource _fin = new();
    private CancellationTokenSource? _carga;
    private Task? _temporizador;
    private long _version;
    private bool _actualizando;
    private bool _pendiente;
    private DateTime _ultimaConsultaUtc;
    private DateTime _ultimaTelemetriaUtc;
    private SaludMonitoreo? _salud;

    [JSInvokable]
    public Task SaludActualizada(string parqueId) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(parqueId, out var id) && id == _parqueId && _salud is not null)
            await _salud.ActualizarAsync();
    });

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parques = await Servicio.ListarParquesAsync(_fin.Token); _parqueId = _parques.FirstOrDefault()?.Id ?? Guid.Empty;
            if (ParqueSeleccionado is { } solicitado && _parques.Any(p => p.Id == solicitado)) _parqueId = solicitado;
            if (_parqueId != Guid.Empty) await ActualizarAsync();
        }
        catch (Exception ex) { RegistrarError(ex); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _modulo = await Js.InvokeAsync<IJSObjectReference>("import", "./js/monitoreo.js?v=ordenes-1");
            _referencia = DotNetObjectReference.Create(this);
            _puente = await _modulo.InvokeAsync<IJSObjectReference>("crear", _referencia);
            await CambiarParqueAsync();
            _temporizador = ReevaluarPeriodicamenteAsync();
        }
        catch (Exception ex) when (!_fin.IsCancellationRequested) { RegistrarError(ex); await InvokeAsync(StateHasChanged); }
    }

    private async Task CambiarParqueAsync()
    {
        Interlocked.Increment(ref _version);
        if (_carga is not null) await _carga.CancelAsync();
        _estado = null; _puntos = []; _error = null;
        _ultimaTelemetriaUtc = default;
        if (_parqueId == Guid.Empty) return;
        var direccion = Navegacion.GetUriWithQueryParameter("parque", _parqueId);
        if (direccion != Navegacion.Uri) Navegacion.NavigateTo(direccion, replace: true);
        if (_puente is not null)
        {
            try { await _puente.InvokeVoidAsync("seleccionar", _parqueId.ToString("D")); }
            catch (JSException) { _conexion = "Sin suscripción"; }
        }
        await ActualizarAsync();
    }

    [JSInvokable]
    public Task NuevaLectura(string parqueId) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(parqueId, out var parqueSalud) && parqueSalud == _parqueId && _salud is not null)
            await _salud.ActualizarAsync();
        if (_ultimaTelemetriaUtc == default && Guid.TryParse(parqueId, out var id) && id == _parqueId)
            await ActualizarAsync();
    });

    [JSInvokable]
    public Task TelemetriaActualizada(List<TelemetriaNodoDto> nodos) => InvokeAsync(() =>
    {
        Logger.LogDebug("Muestra de telemetría recibida: {Nodos} nodos.", nodos.Count);
        if (nodos.Count == 0 || nodos[0].ParqueId != _parqueId) return;
        var estado = TelemetriaMonitoreoMapper.Mapear(_parqueId, nodos);
        _estado = estado;
        _puntos = Serie.Actualizar(estado);
        _ultimaTelemetriaUtc = DateTime.UtcNow;
        _conexion = "Conectado";
        _error = null;
        StateHasChanged();
    });

    [JSInvokable]
    public Task EstadoConexion(string estado) => InvokeAsync(() =>
    {
        _conexion = estado;
        if (estado == "Sesión no autorizada") { _estado = null; _puntos = []; _carga?.Cancel(); }
        StateHasChanged();
    });

    private async Task ActualizarAsync()
    {
        if (_fin.IsCancellationRequested || _parqueId == Guid.Empty || _conexion == "Sesión no autorizada") return;
        if (_actualizando)
        {
            _pendiente = true;
            return;
        }
        _actualizando = true;
        try
        {
            do
            {
                _pendiente = false;
                await ConsultarPersistidosAsync();
            } while (_pendiente && !_fin.IsCancellationRequested);
        }
        finally { _actualizando = false; if (!_fin.IsCancellationRequested) StateHasChanged(); }
    }

    private async Task ConsultarPersistidosAsync()
    {
        var version = Interlocked.Read(ref _version);
        var parque = _parqueId;
        _carga?.Dispose();
        var carga = CancellationTokenSource.CreateLinkedTokenSource(_fin.Token);
        _carga = carga;
        try
        {
            var nuevo = await Servicio.ConsultarAsync(parque, carga.Token);
            if (_ultimaTelemetriaUtc != default || _fin.IsCancellationRequested || !Corresponde(nuevo, version, parque))
                return;
            _estado = nuevo;
            _puntos = Serie.Actualizar(nuevo);
            _error = null;
            _ultimaConsultaUtc = DateTime.UtcNow;
        }
        catch (OperationCanceledException) when (carga.IsCancellationRequested) { /* Se canceló la consulta. */ }
        catch (Exception ex) { if (version == Interlocked.Read(ref _version)) RegistrarError(ex); }
    }

    private async Task ReevaluarPeriodicamenteAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Opciones.Value.ReevaluacionSegundos));
        try
        {
            while (await timer.WaitForNextTickAsync(_fin.Token)) await InvokeAsync(ReevaluarEstadoAsync);
        }
        catch (OperationCanceledException) when (_fin.IsCancellationRequested) { /* La cancelación termina el trabajo pendiente. */ }
    }

    private async Task ReevaluarEstadoAsync()
    {
        if (_estado is null || _conexion == "Sesión no autorizada") return;
        if (_ultimaTelemetriaUtc != default)
        {
            if (DateTime.UtcNow - _ultimaTelemetriaUtc > TimeSpan.FromSeconds(6))
            {
                _conexion = "Sin datos recientes";
                _estado = null;
                StateHasChanged();
            }
            return;
        }
        var version = Interlocked.Read(ref _version);
        var parque = _parqueId;
        try
        {
            var consultarPersistencia = DateTime.UtcNow - _ultimaConsultaUtc >= Configuracion.Intervalo;
            var nuevo = consultarPersistencia
                ? await Servicio.ConsultarAsync(parque, _fin.Token)
                : await Servicio.ReevaluarAsync(parque, _fin.Token);
            if (!Corresponde(nuevo, version, parque)) return;
            _estado = nuevo;
            _puntos = Serie.Actualizar(nuevo);
            if (consultarPersistencia) _ultimaConsultaUtc = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_fin.IsCancellationRequested) { /* La vista se cerró. */ }
        catch (Exception ex) { RegistrarError(ex); }
    }

    private bool Corresponde(EstadoMonitoreoDto estado, long version, Guid parque)
        => version == Interlocked.Read(ref _version) && parque == _parqueId
            && (_estado is null || estado.EvaluadoUtc >= _estado.EvaluadoUtc);

    private void RegistrarError(Exception ex) { Logger.LogError(ex, "No se pudo actualizar el monitoreo."); _error = "No se pudo consultar el monitoreo. Los valores conservan su fecha original."; }
    private static string Potencia(decimal? valor) => valor.HasValue ? $"{valor.Value:N2} W" : "Sin datos vigentes";
    private static string Fecha(DateTime? fecha) => fecha?.ToString("yyyy-MM-dd HH:mm:ss.ffffff 'UTC'") ?? "Sin fecha disponible";
    private static string Cobertura(ResumenGeneracion dato) => $"{(dato.Completo ? "Completo" : "Parcial / sin datos")} · {dato.PanelesConDatos}/{dato.TotalPaneles} paneles vigentes";
    private static string Disponibilidad(DisponibilidadMonitoreo estado) => estado switch
    {
        DisponibilidadMonitoreo.Vigente => "Vigente",
        DisponibilidadMonitoreo.SinDatos => "Sin datos",
        DisponibilidadMonitoreo.FueraDeVigencia => "Fuera de vigencia",
        DisponibilidadMonitoreo.NodoAnterior => "Medición de un nodo anterior",
        DisponibilidadMonitoreo.NodoHistoricoDesconocido => "Nodo histórico sin verificar",
        _ => "Intervalo incompatible"
    };

    public async ValueTask DisposeAsync()
    {
        await _fin.CancelAsync();
        if (_carga is not null) await _carga.CancelAsync();
        if (_temporizador is not null) await _temporizador;
        try
        {
            if (_puente is not null) { await _puente.InvokeVoidAsync("dispose"); await _puente.DisposeAsync(); }
            if (_modulo is not null) await _modulo.DisposeAsync();
        }
        catch (JSDisconnectedException) { /* El circuito ya se cerró. */ }
        _referencia?.Dispose(); _carga?.Dispose(); _fin.Dispose();
    }
}
