@page "/monitoreo"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@using SolarUY.Application.Monitoreo
@using SolarUY.Domain.Monitoreo
@using SolarUY.Presentation.Monitoreo
@implements IAsyncDisposable
@inject IMonitoreoService Servicio
@inject SerieMonitoreoService Serie
@inject IJSRuntime Js
@inject Microsoft.Extensions.Options.IOptions<MonitoreoOptions> Opciones
@inject ILogger<Monitoreo> Logger
@inject NavigationManager Navegacion

<PageTitle>Monitoreo | SolarUY</PageTitle>
<PageHeader Title="Monitoreo en vivo" Section="Energía" Description="Potencia medida del parque, sus nodos y paneles." />
<section class="surface" aria-label="Monitoreo de generación">
    <div class="filter-bar">
        <label>Parque solar
            <RadzenDropDown Name="ParqueMonitoreo" data-testid="selector-parque" TValue="Guid" Data="_parques" TextProperty="Nombre" ValueProperty="Id"
                @bind-Value="_parqueId" Change="CambiarParqueAsync" Style="min-width:260px" />
        </label>
        <p role="status">Conexión: <span data-monitoreo-conexion>@_conexion</span></p>
    </div>
    <p class="note">Potencia en W · Fechas UTC · Los valores parciales excluyen paneles sin muestras compatibles.</p>
    @if (_error is not null) { <p role="alert" class="text-danger">@_error</p> }
    @if (_parques.Count == 0) { <p>No hay parques disponibles.</p> }
    @if (_estado is { } estado)
    {
        <h2>@estado.Nombre</h2>
        <p class="metric-value">@Potencia(estado.Generacion.PotenciaW)</p>
        <p>@Cobertura(estado.Generacion) · Lecturas: @Fecha(estado.Generacion.FechaDesdeUtc) — @Fecha(estado.Generacion.FechaHastaUtc)</p>
        @foreach (var nodo in estado.Nodos)
        {
            <section class="surface" @key="nodo.Id">
                <h3>@nodo.Nombre · @Potencia(nodo.Generacion.PotenciaW)</h3>
                <p>@Cobertura(nodo.Generacion)</p>
                <RadzenDataGrid Data="nodo.Paneles" TItem="PanelMonitoreoDto" AllowPaging="true" PageSize="20">
                    <Columns>
                        <RadzenDataGridColumn TItem="PanelMonitoreoDto" Property="NumeroSerie" Title="Panel / serie" />
                        <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Potencia"><Template Context="panel">@Potencia(panel.Generacion.PotenciaW)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Disponibilidad"><Template Context="panel">@Disponibilidad(panel.Generacion.Disponibilidad)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PanelMonitoreoDto" Title="Medición UTC"><Template Context="panel">@Fecha(panel.Generacion.FechaHoraUtc)</Template></RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                @if (nodo.Paneles.Count == 0) { <p>Sin paneles.</p> }
            </section>
        }
        @if (estado.Nodos.Count == 0) { <p>Sin nodos.</p> }
    }
</section>
<section class="surface" aria-label="Gráfico de potencia en vivo">
    <h2>Evolución de potencia del parque</h2>
    <p class="note">UTC · W · Hasta @Opciones.Value.MaximoPuntosGrafico puntos. Se inicia un tramo nuevo tras intervalos sin muestras. Los puntos pueden representar cobertura parcial.</p>
    @if (_puntos.Count > 0)
    {
        <RadzenChart Style="height:320px">
            <RadzenLineSeries Data="_puntos" TItem="PuntoGeneracionDto" CategoryProperty="FechaHoraUtc" ValueProperty="PotenciaW" Title="Potencia medida (W)" />
            <RadzenCategoryAxis FormatString="{0:HH:mm:ss}"><RadzenAxisTitle Text="Fecha/hora UTC" /></RadzenCategoryAxis>
            <RadzenValueAxis><RadzenAxisTitle Text="Potencia (W)" /></RadzenValueAxis>
        </RadzenChart>
        <details><summary>Fechas y cobertura de los puntos</summary>
            @foreach (var punto in _puntos) { <p>@Fecha(punto.FechaHoraUtc) · @Potencia(punto.PotenciaW) · @(punto.Parcial ? "Parcial" : "Completo")</p> }
        </details>
    }
    else { <p>Aún no hay puntos disponibles.</p> }
</section>

@code {
    [SupplyParameterFromQuery(Name = "parque")]
    public Guid? ParqueSeleccionado { get; set; }
    private IReadOnlyList<ParqueMonitoreoDto> _parques = [];
    private Guid _parqueId;
    private EstadoMonitoreoDto? _estado;
    private IReadOnlyList<PuntoGeneracionDto> _puntos = [];
    private string _conexion = "Conectando";
    private string? _error;
    private IJSObjectReference? _modulo;
    private IJSObjectReference? _puente;
    private DotNetObjectReference<Monitoreo>? _referencia;
    private readonly CancellationTokenSource _fin = new();
    private CancellationTokenSource? _carga;
    private Task? _temporizador;
    private long _version;
    private bool _actualizando;
    private bool _pendiente;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parques = await Servicio.ListarParquesAsync(_fin.Token); _parqueId = _parques.FirstOrDefault()?.Id ?? Guid.Empty;
            if (ParqueSeleccionado is { } solicitado && _parques.Any(p => p.Id == solicitado)) _parqueId = solicitado;
            if (_parqueId != Guid.Empty) await ActualizarAsync(false);
        }
        catch (Exception ex) { RegistrarError(ex); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _modulo = await Js.InvokeAsync<IJSObjectReference>("import", "./js/monitoreo.js");
            _referencia = DotNetObjectReference.Create(this);
            _puente = await _modulo.InvokeAsync<IJSObjectReference>("crear", _referencia);
            await CambiarParqueAsync();
            _temporizador = ReevaluarPeriodicamenteAsync();
        }
        catch (Exception ex) when (!_fin.IsCancellationRequested) { RegistrarError(ex); await InvokeAsync(StateHasChanged); }
    }

    private async Task CambiarParqueAsync()
    {
        Interlocked.Increment(ref _version);
        _carga?.Cancel(); _estado = null; _puntos = []; _error = null;
        if (_parqueId == Guid.Empty) return;
        var direccion = Navegacion.GetUriWithQueryParameter("parque", _parqueId);
        if (direccion != Navegacion.Uri) Navegacion.NavigateTo(direccion, replace: true);
        if (_puente is not null)
        {
            try { await _puente.InvokeVoidAsync("seleccionar", _parqueId.ToString("D")); }
            catch (JSException) { _conexion = "Sin suscripción"; }
        }
        await ActualizarAsync(false);
    }

    [JSInvokable]
    public Task NuevaLectura(string parqueId) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(parqueId, out var id) && id == _parqueId) await ActualizarAsync(false);
    });

    [JSInvokable]
    public Task EstadoConexion(string estado) => InvokeAsync(() =>
    {
        _conexion = estado;
        if (estado == "Sesión no autorizada") { _estado = null; _puntos = []; _carga?.Cancel(); }
        StateHasChanged();
    });

    private async Task ActualizarAsync(bool reevaluar)
    {
        if (_fin.IsCancellationRequested || _parqueId == Guid.Empty || _conexion == "Sesión no autorizada") return;
        if (_actualizando) { if (!reevaluar) _pendiente = true; return; }
        _actualizando = true;
        try
        {
            do
            {
                _pendiente = false;
                var version = Interlocked.Read(ref _version); var parque = _parqueId;
                _carga?.Dispose(); _carga = CancellationTokenSource.CreateLinkedTokenSource(_fin.Token);
                try
                {
                    var nuevo = reevaluar ? await Servicio.ReevaluarAsync(parque, _carga.Token)
                        : await Servicio.ConsultarAsync(parque, _carga.Token);
                    if (version == Interlocked.Read(ref _version) && parque == _parqueId && !_fin.IsCancellationRequested
                        && (_estado is null || nuevo.EvaluadoUtc >= _estado.EvaluadoUtc))
                    { _estado = nuevo; _puntos = Serie.Actualizar(nuevo); _error = null; }
                }
                catch (OperationCanceledException) when (_carga.IsCancellationRequested) { }
                catch (Exception ex) { if (version == Interlocked.Read(ref _version)) RegistrarError(ex); }
                reevaluar = false;
            } while (_pendiente && !_fin.IsCancellationRequested);
        }
        finally { _actualizando = false; if (!_fin.IsCancellationRequested) StateHasChanged(); }
    }

    private async Task ReevaluarPeriodicamenteAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Opciones.Value.ReevaluacionSegundos));
        try
        {
            while (await timer.WaitForNextTickAsync(_fin.Token)) await InvokeAsync(async () =>
            {
                if (_estado is null || _conexion == "Sesión no autorizada") return;
                var version = Interlocked.Read(ref _version); var parque = _parqueId;
                try
                {
                    var nuevo = await Servicio.ReevaluarAsync(parque, _fin.Token);
                    if (version == Interlocked.Read(ref _version) && parque == _parqueId
                        && (_estado is null || nuevo.EvaluadoUtc >= _estado.EvaluadoUtc))
                    { _estado = nuevo; _puntos = Serie.Actualizar(nuevo); StateHasChanged(); }
                }
                catch (OperationCanceledException) when (_fin.IsCancellationRequested) { }
                catch (Exception ex) { RegistrarError(ex); }
            });
        }
        catch (OperationCanceledException) when (_fin.IsCancellationRequested) { }
    }

    private void RegistrarError(Exception ex) { Logger.LogError(ex, "No se pudo actualizar el monitoreo."); _error = "No se pudo consultar el monitoreo. Los valores conservan su fecha original."; }
    private static string Potencia(decimal? valor) => valor.HasValue ? $"{valor.Value:N2} W" : "Sin datos vigentes";
    private static string Fecha(DateTime? fecha) => fecha?.ToString("yyyy-MM-dd HH:mm:ss.ffffff 'UTC'") ?? "Sin fecha disponible";
    private static string Cobertura(ResumenGeneracion dato) => $"{(dato.Completo ? "Completo" : "Parcial / sin datos")} · {dato.PanelesConDatos}/{dato.TotalPaneles} paneles vigentes";
    private static string Disponibilidad(DisponibilidadMonitoreo estado) => estado switch
    {
        DisponibilidadMonitoreo.Vigente => "Vigente",
        DisponibilidadMonitoreo.SinDatos => "Sin datos",
        DisponibilidadMonitoreo.FueraDeVigencia => "Fuera de vigencia",
        DisponibilidadMonitoreo.NodoAnterior => "Medición de un nodo anterior",
        DisponibilidadMonitoreo.NodoHistoricoDesconocido => "Nodo histórico sin verificar",
        _ => "Intervalo incompatible"
    };

    public async ValueTask DisposeAsync()
    {
        _fin.Cancel(); _carga?.Cancel();
        if (_temporizador is not null) await _temporizador;
        try
        {
            if (_puente is not null) { await _puente.InvokeVoidAsync("dispose"); await _puente.DisposeAsync(); }
            if (_modulo is not null) await _modulo.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _referencia?.Dispose(); _carga?.Dispose(); _fin.Dispose();
    }
}
