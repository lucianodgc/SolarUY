@page "/parques-solares/{ParqueId:guid}/nodos"
@attribute [Authorize(Roles = "Administrador,Tecnico,Consulta")]
@rendermode InteractiveServer
@inject INodoService Service

<PageTitle>Nodos del parque</PageTitle>
<PageHeader Title="Nodos" Section="Gestión del parque" Description="Consultá los nodos y sus inversores asociados.">
    <AuthorizeView Roles="Administrador"><a class="btn btn-primary" href="@($"/parques-solares/{ParqueId}/nodos/alta")">Registrar nodo</a></AuthorizeView>
</PageHeader>
@if (_error is not null)
{
    <p role="alert" class="alert alert-danger">@_error</p>
}
else if (_nodos is null)
{
    <p class="loading-state" role="status">Cargando nodos…</p>
}
else if (_nodos.Count == 0)
{
    <div class="surface empty-state"><h2>No hay nodos registrados</h2></div>
}
else
{
    <div class="surface table-responsive">
        <table class="table">
            <thead><tr><th>Nodo</th><th>Ubicación</th><th>Paneles previstos</th><th>Inversor</th><th>Estado</th><th>Volcado a red</th><AuthorizeView Roles="Administrador"><th>Acciones</th></AuthorizeView></tr></thead>
            <tbody>
                @foreach (var nodo in _nodos)
                {
                    <tr><td>@nodo.Nombre</td><td>@nodo.UbicacionEnParque</td><td>@(nodo.CantidadPanelesPrevista?.ToString() ?? "Sin especificar")</td>
                        <td>@nodo.Inversor.Marca @nodo.Inversor.Modelo</td><td>@nodo.Inversor.Estado</td><td>@(nodo.Inversor.VolcadoRedActivo ? "Activo" : "Inactivo")</td>
                        <AuthorizeView Roles="Administrador"><td><div class="action-buttons"><a class="btn btn-outline-primary btn-sm" href="@($"/nodos/{nodo.Id}/editar")">Editar</a><RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Text="Eliminar" Disabled="_ocupado" Click="async () => await EliminarAsync(nodo.Id)" /></div></td></AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public Guid ParqueId { get; set; }
    [Inject] private DialogService Dialogs { get; set; } = null!;
    [Inject] private NotificationService Notifications { get; set; } = null!;
    private IReadOnlyList<NodoDto>? _nodos;
    private string? _error;
    private bool _ocupado;

    protected override async Task OnParametersSetAsync() => await CargarAsync();
    private async Task CargarAsync()
    {
        try { _nodos = await Service.ListarPorParqueAsync(ParqueId); }
        catch (Exception) { _error = "No se pudieron consultar los nodos."; }
    }
    private async Task EliminarAsync(Guid id)
    {
        if (_ocupado) return;
        _ocupado = true;
        try
        {
            if (await Dialogs.Confirm("Se eliminarán el nodo, su inversor, paneles, tareas y lecturas. Esta acción no se puede deshacer.", "Confirmar baja", new ConfirmOptions { OkButtonText = "Eliminar", CancelButtonText = "Cancelar" }) != true) return;
            await Service.EliminarAsync(id);
            Notifications.Notify(NotificationSeverity.Success, "Nodo eliminado", "El nodo y sus dependencias se eliminaron correctamente.");
            await CargarAsync();
        }
        catch (InvalidOperationException exception) { _error = exception.Message; }
        catch (Exception) { _error = "No se pudo eliminar el nodo."; }
        finally { _ocupado = false; }
    }
}
