@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageHeader Title="No pudimos completar la operación" Section="Error" Description="Volvé al inicio e intentá nuevamente." />
<section class="surface">
<p role="alert">Ocurrió un error al procesar la solicitud.</p>

@if (ShowRequestId)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@RequestId</code>
    </p>
}

<a class="btn btn-primary" href="/">Volver al inicio</a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
