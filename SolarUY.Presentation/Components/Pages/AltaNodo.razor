@page "/parques-solares/{ParqueId:guid}/nodos/alta"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@inject INodoService Service
@inject NavigationManager Navigation

<PageTitle>Registrar nodo</PageTitle>
<PageHeader Title="Registrar nodo" Section="Gestión del parque" Description="El nodo se crea junto con su inversor."></PageHeader>
@if (_error is not null) { <p role="alert" class="alert alert-danger">@_error</p> }
<RadzenTemplateForm TItem="CrearNodoDto" Data="_modelo" Submit="GuardarAsync">
    <div class="surface form-surface form-stack"><RadzenFieldset Text="Nodo">

<div class="form-field"><RadzenLabel Text="Nombre" Component="Nombre" /><RadzenTextBox Name="Nombre" @bind-Value="_modelo.Nombre" Style="width:100%" /></div>

<div class="form-field"><RadzenLabel Text="Ubicación en el parque" Component="Ubicacion" /><RadzenTextBox Name="Ubicacion" @bind-Value="_modelo.UbicacionEnParque" Style="width:100%" /></div>

<div class="form-field"><RadzenLabel Text="Cantidad de paneles prevista (opcional)" Component="CantidadPaneles" /><RadzenNumeric Name="CantidadPaneles" @bind-Value="_modelo.CantidadPanelesPrevista" Style="width:100%" /></div>

    </RadzenFieldset><RadzenFieldset Text="Inversor">

<div class="form-field"><RadzenLabel Text="Marca" Component="Marca" /><RadzenTextBox Name="Marca" @bind-Value="_modelo.MarcaInversor" Style="width:100%" /></div>

<div class="form-field"><RadzenLabel Text="Modelo" Component="Modelo" /><RadzenTextBox Name="Modelo" @bind-Value="_modelo.ModeloInversor" Style="width:100%" /></div>

<div class="form-field"><RadzenLabel Text="Potencia nominal (kW)" Component="Potencia" /><RadzenNumeric Name="Potencia" @bind-Value="_modelo.PotenciaNominalKW" Style="width:100%" /></div>

<div class="form-field"><RadzenLabel Text="Estado del inversor" Component="Estado" /><RadzenDropDown Name="Estado" @bind-Value="_modelo.EstadoInversor" Data="_estados" Style="width:100%" /></div>

        <RadzenCheckBox Name="Volcado" @bind-Value="_modelo.VolcadoRedActivo" /> <RadzenLabel Text="Volcado a red activo" Component="Volcado" />
    </RadzenFieldset><div class="action-buttons"><RadzenButton ButtonType="ButtonType.Submit" Text="Guardar" IsBusy="_ocupado" Disabled="_ocupado" /> <a class="btn btn-light" href="@($"/parques-solares/{ParqueId}/nodos")">Cancelar</a></div></div>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid ParqueId { get; set; }
    private readonly CrearNodoDto _modelo = new() { EstadoInversor = EstadoInversor.Apagado };
    private readonly EstadoInversor[] _estados = [EstadoInversor.Encendido, EstadoInversor.Apagado];
    private string? _error;
    private bool _ocupado;
    private async Task GuardarAsync(CrearNodoDto modelo)
    {
        if (_ocupado) return;
        _ocupado = true; _error = null;
        try { await Service.CrearAsync(ParqueId, modelo); Navigation.NavigateTo($"/parques-solares/{ParqueId}/nodos"); }
        catch (Exception) { _error = "No se pudo registrar el nodo. Revisá los datos ingresados."; }
        finally { _ocupado = false; }
    }
}
