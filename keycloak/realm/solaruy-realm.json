{
  "realm": "solaruy",
  "enabled": true,
  "displayName": "SolarUY",
  "roles": {
    "realm": [
      { "name": "Administrador" },
      { "name": "Tecnico" },
      { "name": "Consulta" }
    ]
  },
  "clients": [
    {
      "clientId": "solaruy-tecnico-directory",
      "name": "SolarUY directorio de técnicos (solo lectura)",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    },
    {
      "clientId": "solaruy-web",
      "name": "SolarUY Blazor Server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5219/signin-oidc",
        "https://localhost:7271/signin-oidc"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5219/*##https://localhost:7271/*"
      },
      "webOrigins": [
        "http://localhost:5219",
        "https://localhost:7271"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-solaruy-tecnico-directory",
      "enabled": true,
      "serviceAccountClientId": "solaruy-tecnico-directory",
      "clientRoles": {
        "realm-management": ["view-users", "query-users"]
      }
    },
    {
      "username": "admin.test",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.test@solaruy.local",
      "firstName": "Administrador",
      "lastName": "Prueba",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_TEST_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["Administrador"]
    },
    {
      "username": "tecnico.test",
      "enabled": true,
      "emailVerified": true,
      "email": "tecnico.test@solaruy.local",
      "firstName": "Técnico",
      "lastName": "Prueba",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_TEST_TECH_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["Tecnico"]
    },
    {
      "username": "consulta.test",
      "enabled": true,
      "emailVerified": true,
      "email": "consulta.test@solaruy.local",
      "firstName": "Consulta",
      "lastName": "Prueba",
      "credentials": [
        { "type": "password", "value": "${KEYCLOAK_TEST_VIEWER_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["Consulta"]
    }
  ]
}
