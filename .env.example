# Copia este archivo como .env. Cada integrante usa su propio archivo local.
# Puedes conservar los nombres de base/usuario; inventa contraseñas locales seguras.

MARIADB_DATABASE=solaruy
MARIADB_USER=solaruy
MARIADB_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL
MARIADB_ROOT_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_ROOT_LOCAL

PMA_HOST=mariadb
PMA_PORT=3306

# Credenciales locales de administración y de los usuarios de prueba de Keycloak.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL
KEYCLOAK_TEST_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL
KEYCLOAK_TEST_TECH_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL
KEYCLOAK_TEST_VIEWER_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_LOCAL

# Déjalos vacíos al primer inicio. Keycloak genera estos secretos; cópialos
# desde Clients → Credentials después de iniciar mariadb y keycloak.
SOLARUY_WEB_CLIENT_SECRET=
SOLARUY_DIRECTORY_CLIENT_SECRET=

# Opcional: Ollama en otra PC (IP local o de VPN). Activa ambas opciones.
# SOLARUY_OLLAMA_ENDPOINT=http://192.168.1.50:11434/
# SOLARUY_OLLAMA_PERMITIR_REMOTO=true
