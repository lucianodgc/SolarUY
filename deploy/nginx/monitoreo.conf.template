map $http_upgrade $conexion_upgrade { default upgrade; '' close; }

upstream solaruy_a {
    zone solaruy_a 64k;
    ip_hash;
    server ${SOLARUY_INSTANCIA_A} max_fails=1 fail_timeout=5s;
    server ${SOLARUY_INSTANCIA_B} max_fails=1 fail_timeout=5s;
}
server {
    listen 8080;
    server_name _;
    client_header_buffer_size 16k;
    large_client_header_buffers 4 32k;
    location / {
        proxy_pass http://solaruy_a;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $conexion_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 3s;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
        proxy_buffering off;
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }
}
